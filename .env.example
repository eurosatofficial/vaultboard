# HTTP port exposed by Vaultboard
PORT=3001

# Host port used by docker-compose.yml
VAULTBOARD_PORT=3001

# SQLite database location. The Docker image stores this inside /app/data.
DATABASE_PATH=./data/vaultboard.db

# Set to true only if you want more than the first account to self-register.
ALLOW_REGISTRATION=false

# Set to production for compiled frontend serving and production security headers.
NODE_ENV=production

# Optional: trust one reverse proxy hop for correct client IPs and HTTPS cookies.
TRUST_PROXY=1
